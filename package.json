{
  "name": "retasusan-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "prebuild": "npm run content:build",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run content:build && nuxt typecheck && tsc -p tsconfig.content.json",
    "content:build": "node --import tsx scripts/content-build.ts",
    "content:check": "node --import tsx scripts/content-check.ts",
    "content:new": "node --import tsx scripts/content-new.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "microcms-js-sdk": "^3.1.2",
    "nuxt": "^4.0.0",
    "prismjs": "^1.29.0",
    "rehype-parse": "^9.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/hast": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.5",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vue-tsc": "^3.0.0"
  },
  "type": "module"
}
